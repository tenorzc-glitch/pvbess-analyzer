# Supabase 配置 - 复制此文件为 .env.local 并填入实际值

# Supabase 项目 URL（控制台 → Settings → API → Project URL）
# 格式：https://<your-project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase Publishable/Anon Key（控制台 → Settings → API → Project API keys → anon public）
VITE_SUPABASE_PUBLISHABLE_KEY=

# 语言（'zh' | 'en'）
VITE_DEFAULT_LANGUAGE=zh

# 主题（'light' | 'dark'）
VITE_DEFAULT_THEME=light