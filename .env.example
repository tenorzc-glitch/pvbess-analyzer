# Supabase 配置 - 复制此文件为 .env.local 并填入实际值
# 注意：Vite 环境变量在构建期内联。Vercel/Netlify 等托管平台
# 需要在项目设置的 Environment Variables 中配置同名变量后重新部署。

# Supabase 项目 URL（控制台 → Settings → API → Project URL）
# 格式：https://<your-project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase Anon/Publishable Key（控制台 → Settings → API → Project API keys → anon public）
VITE_SUPABASE_ANON_KEY=

# 语言（'zh' | 'en'）
VITE_DEFAULT_LANGUAGE=en

# 主题（'light' | 'dark'）
VITE_DEFAULT_THEME=dark